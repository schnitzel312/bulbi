#!/usr/sbin/nft -f
# Generated by bulbi. Do not edit.
table inet bulbi
delete table inet bulbi
table inet bulbi {
    set pin4 {
        type ipv4_addr . inet_proto . inet_service
        flags interval, timeout
    }
    set pin6 {
        type ipv6_addr . inet_proto . inet_service
        flags interval, timeout
    }
    set block4 {
        type ipv4_addr . inet_proto . inet_service
        flags interval, timeout
    }
    set block6 {
        type ipv6_addr . inet_proto . inet_service
        flags interval, timeout
    }

    # Every DNS packet from the box goes to Bulbi's resolver (R5).
    chain dns_redirect {
        type nat hook output priority -150; policy accept;
        meta skuid 999 return
        tcp dport 53 redirect to :5353
        udp dport 53 redirect to :5353
    }

    # Refuse visibly: ECONNREFUSED instead of a hang.
    chain refuse {
        meta l4proto tcp reject with tcp reset
        reject with icmpx port-unreachable
    }

    chain egress {
        type filter hook output priority 0; policy drop;
        ct state established,related accept
        # The resolver may only reach Docker's DNS; nothing else is exempt.
        meta skuid 999 ip daddr 127.0.0.11 accept
        meta skuid 999 goto refuse
        oif "lo" ip daddr 127.0.0.11 log group 1 prefix "bulbi|deny|denied_protected|-" goto refuse
        oif "lo" accept
        # Address and host rules, most specific first; deny first on ties.
        ip daddr 192.168.65.254 meta l4proto { tcp, udp } th dport { 5672, 15672 } log group 1 prefix "bulbi|allow|allowed_by_rule|1" accept
        ip daddr 8.8.8.8/32 meta l4proto { tcp, udp } th dport { 853 } log group 1 prefix "bulbi|deny|denied_by_rule|4" goto refuse
        ip daddr 192.168.1.20/32 meta l4proto { tcp, udp } th dport { 6379 } log group 1 prefix "bulbi|allow|allowed_by_rule|2" accept
        ip daddr 8.8.8.0/24 meta l4proto { tcp, udp } th dport { 53, 853 } log group 1 prefix "bulbi|allow|allowed_by_rule|3" accept
        # Addresses learned from DNS answers for allowed / denied names.
        meta l4proto { tcp, udp } ip daddr . meta l4proto . th dport @pin4 log group 1 prefix "bulbi|allow|allowed_by_dns|-" accept
        meta l4proto { tcp, udp } ip6 daddr . meta l4proto . th dport @pin6 log group 1 prefix "bulbi|allow|allowed_by_dns|-" accept
        meta l4proto { tcp, udp } ip daddr . meta l4proto . th dport @block4 log group 1 prefix "bulbi|deny|denied_by_dns|-" goto refuse
        meta l4proto { tcp, udp } ip6 daddr . meta l4proto . th dport @block6 log group 1 prefix "bulbi|deny|denied_by_dns|-" goto refuse
        # Local and private destinations need an explicit address rule.
        ip daddr { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.88.99.0/24, 192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4 } log group 1 prefix "bulbi|deny|denied_protected|-" goto refuse
        ip6 daddr { ::/128, ::1/128, 64:ff9b::/96, 64:ff9b:1::/48, 100::/64, 2001::/23, 2001:db8::/32, 2002::/16, fc00::/7, fe80::/10, ff00::/8, ::ffff:0:0/96 } log group 1 prefix "bulbi|deny|denied_protected|-" goto refuse
        log group 1 prefix "bulbi|deny|denied_by_default|-" goto refuse
    }

    # Nothing may open a connection into the box (R3).
    chain ingress {
        type filter hook input priority 0; policy drop;
        ct state established,related accept
        iif "lo" accept
    }
}
